    <!-- Lógica JavaScript do Carrossel Automático, Swipe e Expansão -->
    <!-- STREAMING_CHUNK: Ativando as rotinas JavaScript de navegação do carrossel... -->
    <script>
        const track = document.getElementById('carousel-track');
        const dotsContainer = document.getElementById('carousel-dots');
        const slides = track.children;
        const totalSlides = slides.length;
        
        // Criar os pontos indicadores (Dots)
        for (let i = 0; i < totalSlides; i++) {
            const dot = document.createElement('button');
            dot.className = `w-1.5 h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-[#2dd4bf] w-3.5' : 'bg-white/20'}`;
            dot.setAttribute('aria-label', `Slide ${i + 1}`);
            dot.addEventListener('click', () => {
                track.scrollTo({
                    left: slides[i].offsetLeft - track.offsetLeft,
                    behavior: 'smooth'
                });
            });
            dotsContainer.appendChild(dot);
        }

        const dots = dotsContainer.children;

        // Atualizar Dots Ativos Conforme Rolagem
        track.addEventListener('scroll', () => {
            const width = track.offsetWidth;
            const index = Math.round(track.scrollLeft / width);
            
            for (let i = 0; i < dots.length; i++) {
                if (i === index) {
                    dots[i].classList.add('bg-[#2dd4bf]', 'w-3.5');
                    dots[i].classList.remove('bg-white/20');
                } else {
                    dots[i].classList.remove('bg-[#2dd4bf]', 'w-3.5');
                    dots[i].classList.add('bg-white/20');
                }
            }
        });

        // Loop de Transição Suave Automática (A cada 6s) com reset de volta ao início
        let autoSlide = setInterval(() => {
            const width = track.offsetWidth;
            let nextIndex = Math.round(track.scrollLeft / width) + 1;
            
            // Quando os depoimentos acabam, volta suavemente ao início
            if (nextIndex >= totalSlides) nextIndex = 0;
            
            track.scrollTo({
                left: slides[nextIndex].offsetLeft - track.offsetLeft,
                behavior: 'smooth'
            });
        }, 6000);

        // Resetar tempo automático ao tocar/interagir com o carrossel
        track.addEventListener('touchstart', () => clearInterval(autoSlide), { passive: true });

        // Função de expansão (Ver mais / Ver menos)
        function toggleExpand(id, button) {
            const container = document.getElementById('desc-' + id);
            if (container.classList.contains('max-h-24')) {
                container.classList.remove('max-h-24');
                container.classList.add('max-h-[1000px]'); // Expande para caber todo o conteúdo
                button.textContent = 'Ver menos';
            } else {
                container.classList.remove('max-h-[1000px]');
                container.classList.add('max-h-24');
                button.textContent = 'Ver mais';
            }
        }
    </script>
