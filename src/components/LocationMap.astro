---
const { title = 'Como chegar', compact = false } = Astro.props;
const mapSrc = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3645.375913666474!2d-46.2347967!3d-23.9824992!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce010cfde03e69%3A0x21cbbc8570ea3184!2s!5e0!3m2!1spt-BR!2sbr!4v1784423524116!5m2!1spt-BR!2sbr';
---
<div class:list={['location-map', { compact }]}>
  <div class="location-map-heading"><p class="eyebrow">Localização</p><h2>{title}</h2></div>
  <iframe src={mapSrc} title="Mapa da Grazielle Diniz Estética na Enseada, Guarujá" width="100%" height="100%" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
