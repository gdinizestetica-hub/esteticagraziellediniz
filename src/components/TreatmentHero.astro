---
import { site, whatsapp } from '../data/site';
const { eyebrow, title, description, cta, image = site.image, hideImage = false } = Astro.props;
---
<section class:list={['hero', { 'hero-no-image': hideImage }]}><div class="wrap hero-grid"><div><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="hero-copy">{description}</p><a class="btn coral" href={whatsapp(`Olá! Gostaria de saber mais sobre ${title}.`)} target="_blank" rel="noopener">{cta}</a></div>{!hideImage && <div class="hero-media"><img src={image} alt="Grazielle Diniz, esteticista na Enseada, Guarujá" width="800" height="1000" /><div class="hero-note">Atendimento na Enseada<br /><small>Guarujá · SP</small></div></div>}</div></section>
