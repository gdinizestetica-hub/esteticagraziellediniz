---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { blogPosts } from '../../data/blog';
---
<SiteLayout title="Blog | Depilação a Laser e Estética no Guarujá | Grazielle Diniz" description="Artigos sobre depilação a laser, cuidados com a pele e estética na Enseada, Guarujá, escritos para ajudar você a decidir melhor.">
  <section class="page-hero blog-hero"><div class="wrap"><p class="eyebrow">Conteúdo da Grazielle Diniz</p><h1>Blog</h1><p>Informação objetiva para cuidar da pele e entender melhor cada tratamento.</p></div></section>
  <section class="section blog-index"><div class="wrap"><div class="blog-topic-grid">{blogPosts.map((post, index)=><article class="blog-topic"><span class="blog-topic-number">{String(index + 1).padStart(2, '0')}</span><div><p class="eyebrow">{post.category} · {post.date}</p><h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2><p>{post.excerpt}</p><a class="card-link" href={`/blog/${post.slug}/`}>Ler o artigo →</a></div></article>)}</div></div></section>
</SiteLayout>
