---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TreatmentHero from '../../components/TreatmentHero.astro';
import StoryMedia from '../../components/StoryMedia.astro';
import { whatsapp } from '../../data/site';
const media = [{ type: 'image', src: '/images/foto-da-profissional-esteticista-grazielle-diniz-guaruja.png', alt: 'Grazielle Diniz em atendimento de estética no Guarujá', duration: 'Foto' }];
---
<SiteLayout title="Drenagem Linfática Premium na Enseada, Guarujá - SP | Grazielle Diniz" description="Drenagem linfática premium na Enseada, Guarujá, com manobras manuais e atendimento direcionado para sensação de inchaço e peso.">
<TreatmentHero eyebrow="Drenagem premium · Enseada" title="Drenagem para quem quer se sentir mais leve." description="Um atendimento corporal com manobras manuais, conversa sobre suas queixas e ritmo adequado para o seu momento." cta="Agendar uma avaliação" />
<section class="section story-section"><div class="wrap story-layout"><div><p class="eyebrow">O espaço de atendimento</p><h2>Um ambiente tranquilo para desacelerar.</h2><p>Conheça um pouco do espaço antes de marcar seu horário.</p></div><StoryMedia items={media} label="Mídias da drenagem premium" /></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">Sinais comuns</p><h2>Quando o corpo pede uma pausa.</h2></div><div class="cards"><article class="card"><h3>Pernas pesadas</h3><p>Sensação de cansaço ou peso que aparece especialmente ao fim do dia.</p></article><article class="card"><h3>Inchaço</h3><p>Marcas de roupas, sapatos e anéis mais apertados em alguns períodos.</p></article><article class="card"><h3>Rotina intensa</h3><p>Para quem passa muitas horas em pé, sentado ou quer reservar um tempo de cuidado corporal.</p></article></div></div></section>
<section class="section sage"><div class="wrap split"><div><p class="eyebrow">Atendimento</p><h2>O protocolo é ajustado a partir da conversa.</h2><p>A sessão combina manobras manuais e orientações de acordo com as necessidades identificadas. Em casos específicos, é importante informar condições de saúde e seguir liberações profissionais.</p></div><ul class="checklist"><li>Conversa inicial sobre suas queixas</li><li>Ambiente silencioso e climatizado</li><li>Movimentos manuais calmos e precisos</li><li>Orientações ao final do atendimento</li></ul></div></section>
<section class="section"><div class="wrap" style="text-align:center"><h2>Quer saber se a drenagem faz sentido para você?</h2><p style="margin-inline:auto">Fale pelo WhatsApp e explique o que está sentindo. A avaliação orienta a conversa.</p><a class="btn coral" href={whatsapp('Olá! Gostaria de saber mais sobre drenagem premium.')} target="_blank" rel="noopener">Tirar dúvidas</a></div></section>
</SiteLayout>
