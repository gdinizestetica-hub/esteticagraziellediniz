---
import SiteLayout from '../layouts/SiteLayout.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import { site, treatments, whatsapp } from '../data/site';
const testimonials = [
  { name: 'Ana Teixeira', date: '4 meses atrás', text: 'Ótima profissional, super educada, muito gentil, engraçada... vou fechar todas minhas sessões com ela 😍😍😽' },
  { name: 'Paola Mariano', date: '6 meses atrás', text: 'Fiz depilação a laser e na primeira sessão já tive um resultado muito bom, me surpreendeu. Recomendo demaiss.' },
  { name: 'Priscila Bamondes', date: '1 ano atrás', text: 'Acompanho o trabalho da Grazielle desde 2016 e tive o privilégio de ver de perto toda a sua evolução profissional. Sou cliente há muitos anos. A Grazi vai muito além de uma esteticista: cria conexão, passa segurança e entrega resultado. Recomendo sempre!' },
  { name: 'Jessica Pacheco', date: '10 meses atrás', text: 'Ambiente muito limpinho, mãos de fadas rsrs. Saí super relaxada com a drenagem!' }
];
const faqs = [
  ['Quanto custa a depilação a laser no Guarujá?', 'O investimento varia conforme as áreas escolhidas. A avaliação sem custo ajuda a entender as opções e montar uma orientação de acordo com o que você procura.'],
  ['Onde fica a clínica da Grazielle Diniz?', 'A clínica fica na Av. Dom Pedro I, 1785, sala 406, na Enseada, Guarujá. A referência é o Extra; o espaço possui elevador, ambiente climatizado e fácil acesso.'],
  ['A depilação a laser dói?', 'A sensação varia de pessoa para pessoa e conforme a área. O equipamento possui sistema de resfriamento, e os parâmetros são ajustados de acordo com a avaliação e a resposta da pele.'],
  ['Quantas sessões de depilação a laser são necessárias?', 'A quantidade não é igual para todas as pessoas. O ciclo de crescimento dos pelos, a área tratada, o fototipo e a resposta de cada organismo influenciam o planejamento.'],
  ['A avaliação estética tem custo?', 'Não. A avaliação é sem custo e serve para conversar sobre seu objetivo, observar a pele ou a área a ser tratada e explicar o caminho possível.'],
  ['Quais são os horários de atendimento?', 'De segunda a sexta, das 08h às 21h, e aos sábados, das 08h às 18h. Para consultar disponibilidade, envie uma mensagem pelo WhatsApp.']
];
---
<SiteLayout title="Depilação a Laser no Guarujá | Drenagem Linfática | Grazielle Diniz" description="Grazielle Diniz Estética: depilação a laser, drenagem premium e limpeza de pele na Enseada, Guarujá. Conheça a profissional e agende sua avaliação.">
  <section class="home-hero"><div class="wrap home-hero-grid"><div class="home-hero-copy"><p class="eyebrow">Grazielle Diniz · Estética na Enseada</p><h1>Depilação a Laser e Estética na Enseada - Guarujá</h1><p class="hero-copy">Depilação a laser, drenagem premium, limpeza de pele e tratamentos estéticos realizados pela Grazielle Diniz, na Enseada.</p><div class="hero-actions"><a class="btn coral" href={whatsapp('Olá! Gostaria de agendar uma avaliação.')} target="_blank" rel="noopener">Agendar avaliação</a><a class="text-link" href="#tratamentos">Conhecer os tratamentos <span>→</span></a></div></div><div class="home-hero-image"><img src={site.image} alt="Grazielle Diniz, esteticista na Enseada, Guarujá" width="800" height="1000" loading="eager" /><div class="hero-badge"><strong>Esteticista</strong><span>&amp; Cosmetóloga</span></div></div></div></section>
  <section class="home-intro section"><div class="wrap intro-grid"><div><p class="eyebrow">Quem cuida de você</p><h2>Esteticista e cosmetóloga na Enseada.</h2></div><div><p>Grazielle Diniz é formada em Cosmetologia e Estética e atua há mais de 8 anos na área. O atendimento acontece diretamente com ela, em um espaço na Enseada, Guarujá.</p><p>A avaliação sem custo ajuda a definir o caminho mais adequado, com explicações sobre cada etapa e cuidados necessários.</p><a class="card-link" href="/bio/">Conheça a Grazielle →</a></div></div></section>
  <section class="home-treatments section sand" id="tratamentos"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Tratamentos estéticos</p><h2>Conheça os principais tratamentos.</h2><p>Veja o que é feito em cada atendimento e acesse a página completa para entender se ele pode ser indicado para você.</p></div><div class="cards">{treatments.map((treatment)=><TreatmentCard treatment={treatment}/>)}</div><div class="center-cta"><a class="text-link" href="/contato/">Ainda tem dúvida? Fale com a Grazielle →</a></div></div></section>
  <section class="home-process section"><div class="wrap process-grid"><div class="process-image"><img src={site.image} alt="Atendimento de estética da Grazielle Diniz no Guarujá" width="800" height="1000" loading="lazy" /></div><div><p class="eyebrow">Como funciona</p><h2>Você entende o cuidado antes de começar.</h2><p>O atendimento é conduzido em quatro passos simples:</p><ol class="steps"><li><strong>Conversa inicial</strong><span>Você conta o que deseja melhorar e tira suas dúvidas.</span></li><li><strong>Avaliação</strong><span>Observamos as características da pele ou do corpo e o seu histórico.</span></li><li><strong>Indicação</strong><span>Explicamos o tratamento, a frequência e os cuidados envolvidos.</span></li><li><strong>Acompanhamento</strong><span>Você recebe orientação para seguir com segurança entre as sessões.</span></li></ol><a class="btn" href={whatsapp('Olá! Gostaria de saber como funciona a avaliação.')} target="_blank" rel="noopener">Tirar dúvidas</a></div></div></section>
  <section class="home-technology section sage"><div class="wrap technology-grid"><div><p class="eyebrow">Tecnologia utilizada</p><h2>Ácrus HTM Triple Wave</h2><p>O equipamento é seguro para diferentes fototipos de pele. A Grazielle avalia cada caso e ajusta os parâmetros a cada sessão, de acordo com a pele, a área tratada e a resposta ao tratamento, buscando uma aplicação eficaz e responsável.</p><a class="card-link" href="/depilacao-laser-guaruja/">Entender a depilação a laser →</a></div><div class="tech-card"><span class="tech-label">Equipamento</span><strong>Ácrus<br />HTM</strong><span>Triple Wave</span></div></div></section>
  <section class="home-testimonials section"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Experiências reais</p><h2>O que as clientes contam.</h2><p>Leia os comentários completos e navegue pelos relatos.</p></div><div class="testimonial-carousel"><button class="carousel-arrow" type="button" data-testimonial-prev aria-label="Depoimento anterior">←</button><div class="testimonial-rail" data-testimonial-rail>{testimonials.map((item)=><article class="testimonial"><div class="stars" aria-label="5 estrelas">★★★★★ <small>{item.date}</small></div><p>“{item.text}”</p><strong>{item.name}</strong><details><summary>Ler comentário completo</summary><p>{item.text}</p></details></article>)}</div><button class="carousel-arrow" type="button" data-testimonial-next aria-label="Próximo depoimento">→</button></div><div class="center-cta"><a class="text-link" href="/depoimentos/">Ver todos os depoimentos →</a></div></div></section>
  <section class="home-location section sand"><div class="wrap location-grid"><div><p class="eyebrow">A clínica</p><h2>Na Enseada, com fácil acesso.</h2><p>{site.address}. {site.reference}</p><div class="location-facts"><span>Elevador</span><span>Ambiente climatizado</span><span>Fácil acesso</span></div><a class="btn" href="/contato/">Ver localização</a></div><div class="location-panel"><p class="eyebrow">Horário de atendimento</p><h3>Segunda a sexta</h3><p>08h às 21h</p><h3>Sábado</h3><p>08h às 18h</p><a href={whatsapp('Olá! Gostaria de consultar um horário.')} target="_blank" rel="noopener">Consultar disponibilidade →</a></div></div></section>
  <section class="home-faq section"><div class="wrap faq-grid"><div><p class="eyebrow">Perguntas frequentes</p><h2>Antes de agendar, tire suas dúvidas.</h2><p>Reunimos as perguntas mais comuns sobre tratamentos, avaliação, localização e horários.</p></div><div class="faq">{faqs.map(([question, answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  <section class="home-final-cta"><div class="wrap"><p class="eyebrow">Vamos conversar?</p><h2>O próximo passo pode ser uma pergunta.</h2><p>Conte o que você procura e receba uma orientação inicial pelo WhatsApp.</p><a class="btn coral" href={whatsapp('Olá! Vim pelo site e gostaria de conversar sobre um tratamento.')} target="_blank" rel="noopener">Falar pelo WhatsApp</a></div></section>
</SiteLayout>
<script is:inline>
  const rail = document.querySelector('[data-testimonial-rail]');
  document.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => rail?.scrollBy({ left: -340, behavior: 'smooth' }));
  document.querySelector('[data-testimonial-next]')?.addEventListener('click', () => rail?.scrollBy({ left: 340, behavior: 'smooth' }));
</script>
