---
import SiteLayout from '../layouts/SiteLayout.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import { site, treatments, whatsapp } from '../data/site';
import { reviews } from '../data/content';
const faqs = [
  ['Quanto custa a depilação a laser no Guarujá?', 'O investimento varia conforme as áreas escolhidas. A avaliação sem custo ajuda a entender as opções e montar uma orientação de acordo com o que você procura.'],
  ['Onde fica a clínica da Grazielle Diniz?', 'A clínica fica na Av. Dom Pedro I, 1785, sala 406, na Enseada, Guarujá.'],
  ['A depilação a laser dói?', 'A sensação varia conforme a pessoa e a área. O equipamento possui resfriamento e os parâmetros são ajustados na avaliação.'],
  ['Quantas sessões são necessárias?', 'A quantidade depende do ciclo dos pelos, área tratada, fototipo e resposta individual.'],
  ['A avaliação estética tem custo?', 'Não. A avaliação é sem custo e serve para conversar sobre objetivo, pele e possibilidades.'],
  ['Quais são os horários?', ['Segunda a sexta, das 08h às 21h, e sábado, das 08h às 18h.']]
];
---
<SiteLayout title="Depilação a Laser no Guarujá | Drenagem Linfática | Grazielle Diniz" description="Grazielle Diniz Estética: depilação a laser, drenagem premium e limpeza de pele na Enseada, Guarujá. Conheça a profissional e agende sua avaliação.">
  <section class="home-hero"><div class="mobile-hero-bg" aria-hidden="true"></div><div class="wrap home-hero-grid"><div class="home-hero-copy"><h1>Depilação a Laser e Estética na Enseada - Guarujá</h1><p class="hero-copy">Depilação a laser, drenagem linfática, limpeza de pele e tratamentos estéticos realizados pela Grazielle Diniz, na Enseada.</p><div class="hero-actions"><a class="btn" href={whatsapp('Olá! Gostaria de agendar uma avaliação.')} target="_blank" rel="noopener">Agendar avaliação</a><a class="text-link" href="#tratamentos">Conhecer os tratamentos <span>→</span></a></div></div><div class="home-hero-image"><img src={site.image} alt="Grazielle Diniz, esteticista na Enseada, Guarujá" width="800" height="1000" loading="eager" /><div class="hero-badge"><strong>Esteticista</strong><span>&amp; Cosmetóloga</span></div></div></div></section>
  <section class="home-intro section"><div class="wrap intro-grid"><div><p class="eyebrow">Quem cuida de você</p><h2>Esteticista e cosmetóloga na Enseada.</h2></div><div><p>Grazielle Diniz é formada em Cosmetologia e Estética e atua há mais de 8 anos na área. O atendimento acontece diretamente com ela, em um espaço na Enseada, Guarujá.</p><p>A avaliação sem custo ajuda a definir o caminho mais adequado, com explicações sobre cada etapa e cuidados necessários.</p><a class="card-link" href="/bio/">Conheça a Grazielle →</a></div></div></section>
  <section class="home-treatments section sand" id="tratamentos"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Tratamentos estéticos</p><h2>Conheça os principais tratamentos.</h2><p>Veja o que é feito em cada atendimento e acesse a página completa.</p></div><div class="cards">{treatments.map((treatment)=><TreatmentCard treatment={treatment}/>)}</div></div></section>
  <section class="home-process section"><div class="wrap process-grid"><div><p class="eyebrow">Como funciona</p><h2>Você entende o cuidado antes de começar.</h2><ol class="steps"><li><strong>Conversa inicial</strong><span>Você conta o que deseja melhorar e tira suas dúvidas.</span></li><li><strong>Avaliação</strong><span>Observamos as características da pele ou do corpo.</span></li><li><strong>Indicação</strong><span>Explicamos o tratamento e os cuidados envolvidos.</span></li><li><strong>Acompanhamento</strong><span>Você recebe orientação entre as sessões.</span></li></ol><a class="btn" href={whatsapp('Olá! Gostaria de saber como funciona a avaliação.')} target="_blank" rel="noopener">Tirar dúvidas</a></div></div></section>
  <section class="home-technology section sage"><div class="wrap technology-grid"><div><p class="eyebrow">Tecnologia utilizada</p><h2>Ácrus HTM Triple Wave</h2><p>O equipamento é seguro para diferentes fototipos de pele. A Grazielle avalia cada caso e ajusta os parâmetros a cada sessão.</p><a class="card-link" href="/depilacao-laser-guaruja/">Entender a depilação a laser →</a></div><div class="tech-card"><span class="tech-label">Equipamento</span><strong>Ácrus<br />HTM</strong><span>Triple Wave</span></div></div></section>
  <section class="home-testimonials section"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Avaliações do Google</p><h2>Experiências reais.</h2><div class="google-rating"><strong>5,0</strong><span class="google-stars">★★★★★</span><small>avaliações de clientes</small></div></div><div class="testimonial-carousel"><button class="carousel-arrow" type="button" data-testimonial-prev aria-label="Avaliação anterior">←</button><div class="testimonial-rail" data-testimonial-rail>{reviews.map((item)=><article class="google-review"><div class="review-top"><span class="review-avatar">{item.name[0]}</span><div><strong>{item.name}</strong><small>Cliente verificada</small></div><span class="review-google">G</span></div><div class="stars">★★★★★</div><p class="review-excerpt">“{item.text.slice(0, 150)}{item.text.length > 150 ? '…' : ''}”</p><button class="review-more" type="button" data-review={item.name}>Ver completo</button></article>)}</div><button class="carousel-arrow" type="button" data-testimonial-next aria-label="Próxima avaliação">→</button></div></div></section>
  <section class="home-location section sand"><div class="wrap location-grid"><div><p class="eyebrow">A clínica</p><h2>Na Enseada, com fácil acesso.</h2><p>{site.address}. {site.reference}</p><div class="location-facts"><span>Elevador</span><span>Ambiente climatizado</span><span>Fácil acesso</span></div><a class="btn" href="/contato/">Ver localização</a></div><div class="location-panel"><p class="eyebrow">Horário de atendimento</p><h3>Segunda a sexta</h3><p>08h às 21h</p><h3>Sábado</h3><p>08h às 18h</p></div></div></section>
  <section class="home-faq section"><div class="wrap faq-grid"><div><p class="eyebrow">Perguntas frequentes</p><h2>Antes de agendar, tire suas dúvidas.</h2></div><div class="faq">{faqs.map(([question, answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  <section class="home-final-cta"><div class="wrap"><p class="eyebrow">Vamos conversar?</p><h2>O próximo passo pode ser uma pergunta.</h2><a class="btn" href={whatsapp('Olá! Vim pelo site e gostaria de conversar sobre um tratamento.')} target="_blank" rel="noopener">Falar pelo WhatsApp</a></div></section>
  <div class="review-modal" data-review-modal role="dialog" aria-modal="true" aria-labelledby="review-modal-name" hidden><div class="review-modal-card"><button type="button" class="review-modal-close" data-review-close aria-label="Fechar avaliação">×</button><div class="review-top"><span class="review-avatar" data-review-avatar></span><div><strong id="review-modal-name" data-review-name></strong><small>Cliente verificada</small></div><span class="review-google">G</span></div><div class="stars">★★★★★</div><p data-review-text></p></div></div>
</SiteLayout>
<script type="application/json" id="review-data" set:html={JSON.stringify(reviews)}></script>
<script is:inline>
  const reviews = JSON.parse(document.getElementById('review-data')?.textContent || '[]');
  const rail = document.querySelector('[data-testimonial-rail]');
  document.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => rail?.scrollBy({ left: -360, behavior: 'smooth' }));
  document.querySelector('[data-testimonial-next]')?.addEventListener('click', () => rail?.scrollBy({ left: 360, behavior: 'smooth' }));
  const modal = document.querySelector('[data-review-modal]');
  document.querySelectorAll('[data-review]').forEach((button) => button.addEventListener('click', () => { const item = reviews.find((review) => review.name === button.dataset.review); if (!item || !modal) return; modal.hidden = false; modal.querySelector('[data-review-name]').textContent = item.name; modal.querySelector('[data-review-avatar]').textContent = item.name[0]; modal.querySelector('[data-review-text]').textContent = `“${item.text}”`; document.body.classList.add('modal-open'); }));
  const closeModal = () => { if (modal) modal.hidden = true; document.body.classList.remove('modal-open'); };
  modal?.querySelector('[data-review-close]')?.addEventListener('click', closeModal); modal?.addEventListener('click', (event) => { if (event.target === modal) closeModal(); }); window.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeModal(); });
</script>
