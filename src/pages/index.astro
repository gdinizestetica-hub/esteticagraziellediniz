---
import SiteLayout from '../layouts/SiteLayout.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import { site, treatments, whatsapp } from '../data/site';
const testimonials = [
  { name: 'Ana Teixeira', text: 'Ótima profissional, super educada e gentil. Vou fechar todas minhas sessões com ela.' },
  { name: 'Paola Mariano', text: 'Fiz depilação a laser e na primeira sessão já tive um resultado muito bom. Recomendo.' },
  { name: 'Jessica Pacheco', text: 'Ambiente muito limpo e mãos de fada. Saí super relaxada com a drenagem.' }
];
---
<SiteLayout title="Depilação a Laser no Guarujá | Drenagem Linfática | Grazielle Diniz" description="Grazielle Diniz Estética: depilação a laser, drenagem premium e limpeza de pele na Enseada, Guarujá. Conheça a profissional e agende sua avaliação.">
  <section class="home-hero"><div class="wrap home-hero-grid"><div class="home-hero-copy"><p class="eyebrow">Grazielle Diniz · Estética na Enseada</p><h1>Tratamentos estéticos com orientação clara e atendimento próximo.</h1><p class="hero-copy">Depilação a laser, drenagem premium e cuidados faciais para quem procura um atendimento tranquilo no Guarujá.</p><div class="hero-actions"><a class="btn coral" href={whatsapp('Olá! Gostaria de agendar uma avaliação.')} target="_blank" rel="noopener">Agendar avaliação</a><a class="text-link" href="#tratamentos">Conhecer os tratamentos <span>→</span></a></div></div><div class="home-hero-image"><img src={site.image} alt="Grazielle Diniz, esteticista na Enseada, Guarujá" width="800" height="1000" loading="eager" /><div class="hero-stamp"><strong>+8 anos</strong><span>de experiência</span></div></div></div></section>

  <section class="home-intro section"><div class="wrap intro-grid"><div><p class="eyebrow">Quem cuida de você</p><h2>Um atendimento direto, sem protocolos automáticos.</h2></div><div><p>Grazielle Diniz atua há mais de 8 anos na estética e atende na Enseada, Guarujá. Cada conversa começa entendendo sua queixa, sua rotina e o que você espera do tratamento.</p><p>A avaliação sem custo ajuda a definir o caminho mais adequado, com explicações sobre cada etapa e cuidados necessários.</p><a class="card-link" href="/bio/">Conheça a Grazielle →</a></div></div></section>

  <section class="home-treatments section sand" id="tratamentos"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Tratamentos estéticos</p><h2>Comece pelo que faz sentido para você.</h2><p>Conheça os principais atendimentos realizados na clínica e veja qual conversa melhor com seu momento.</p></div><div class="cards">{treatments.map((treatment)=><TreatmentCard treatment={treatment}/>)}</div><div class="center-cta"><a class="text-link" href="/contato/">Ainda não sabe qual escolher? Fale com a Grazielle →</a></div></div></section>

  <section class="home-process section"><div class="wrap process-grid"><div class="process-image"><img src={site.image} alt="Atendimento de estética da Grazielle Diniz no Guarujá" width="800" height="1000" loading="lazy" /></div><div><p class="eyebrow">Como funciona</p><h2>Você entende o cuidado antes de começar.</h2><p>O atendimento é conduzido em quatro passos simples:</p><ol class="steps"><li><strong>Conversa inicial</strong><span>Você conta o que deseja melhorar e tira suas dúvidas.</span></li><li><strong>Avaliação</strong><span>Observamos as características da pele ou do corpo e o seu histórico.</span></li><li><strong>Indicação</strong><span>Explicamos o tratamento, a frequência e os cuidados envolvidos.</span></li><li><strong>Acompanhamento</strong><span>Você recebe orientação para seguir com segurança entre as sessões.</span></li></ol><a class="btn" href={whatsapp('Olá! Gostaria de saber como funciona a avaliação.')} target="_blank" rel="noopener">Tirar dúvidas</a></div></div></section>

  <section class="home-technology section sage"><div class="wrap technology-grid"><div><p class="eyebrow">Tecnologia utilizada</p><h2>Ácrus HTM Triple Wave</h2><p>O equipamento faz parte da estrutura de atendimento para depilação a laser. Na avaliação, são conversados os parâmetros e a indicação adequada para cada caso.</p><a class="card-link" href="/depilacao-laser-guaruja/">Entender a depilação a laser →</a></div><div class="tech-card"><span class="tech-label">Equipamento</span><strong>Ácrus<br />HTM</strong><span>Triple Wave</span></div></div></section>

  <section class="home-testimonials section"><div class="wrap"><div class="section-head centered"><p class="eyebrow">Experiências reais</p><h2>O que as clientes contam.</h2></div><div class="testimonial-grid">{testimonials.map((item)=><article class="testimonial"><div class="stars" aria-label="5 estrelas">★★★★★</div><p>“{item.text}”</p><strong>{item.name}</strong></article>)}</div><div class="center-cta"><a class="text-link" href="/depoimentos/">Ver todos os depoimentos →</a></div></div></section>

  <section class="home-location section sand"><div class="wrap location-grid"><div><p class="eyebrow">A clínica</p><h2>Na Enseada, com fácil acesso.</h2><p>{site.address}. {site.reference}</p><div class="location-facts"><span>Elevador</span><span>Ambiente climatizado</span><span>Fácil acesso</span></div><a class="btn" href="/contato/">Ver localização</a></div><div class="location-panel"><p class="eyebrow">Horário de atendimento</p><h3>Segunda a sexta</h3><p>08h às 21h</p><h3>Sábado</h3><p>08h às 18h</p><a href={whatsapp('Olá! Gostaria de consultar um horário.')} target="_blank" rel="noopener">Consultar disponibilidade →</a></div></div></section>

  <section class="home-faq section"><div class="wrap faq-grid"><div><p class="eyebrow">Perguntas frequentes</p><h2>Antes de agendar, tire suas dúvidas.</h2><p>Se sua pergunta não estiver aqui, fale diretamente pelo WhatsApp.</p></div><div class="faq"><details><summary>A avaliação tem custo?</summary><p>Não. A avaliação é sem custo e ajuda a entender o tratamento mais adequado para o seu objetivo.</p></details><details><summary>Onde fica a clínica?</summary><p>Na Av. Dom Pedro I, 1785, sala 406, na Enseada, Guarujá, próxima ao Extra.</p></details><details><summary>Como agendo um horário?</summary><p>Você pode enviar uma mensagem pelo WhatsApp. A Grazielle orienta sobre disponibilidade e próximos passos.</p></details></div></div></section>

  <section class="home-final-cta"><div class="wrap"><p class="eyebrow">Vamos conversar?</p><h2>O próximo passo pode ser uma pergunta.</h2><p>Conte o que você procura e receba uma orientação inicial pelo WhatsApp.</p><a class="btn coral" href={whatsapp('Olá! Vim pelo site e gostaria de conversar sobre um tratamento.')} target="_blank" rel="noopener">Falar pelo WhatsApp</a></div></section>
</SiteLayout>
