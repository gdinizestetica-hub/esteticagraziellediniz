---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TreatmentHero from '../../components/TreatmentHero.astro';
import StoryMedia from '../../components/StoryMedia.astro';
import { whatsapp } from '../../data/site';
import { laserFaqs } from '../../data/content';
const media = [{ type: 'video', src: '/video-background.mp4', alt: 'Vídeo vertical sobre o atendimento de depilação a laser', duration: 'Vídeo', loop: true }];
---
<SiteLayout title="Depilação a Laser na Enseada, Guarujá - SP | Grazielle Diniz" description="Depilação a laser na Enseada, Guarujá, com avaliação, planejamento de sessões e orientação para diferentes fototipos.">
<TreatmentHero hideImage={true} eyebrow="Depilação a laser · Guarujá" title="Depilação a Laser na Enseada - Guarujá - SP" description="A indicação, os intervalos e a expectativa de cada caso são conversados na avaliação. O atendimento utiliza o equipamento Ácrus HTM Triple Wave, conforme o protocolo definido para você." cta="Conhecer o tratamento" />
<section class="section story-section"><div class="wrap story-layout"><div><p class="eyebrow">Por dentro do atendimento</p><h2>Veja um pouco do espaço e da experiência.</h2><p>Uma seleção curta de mídias reais para você conhecer o ambiente antes de agendar.</p></div><StoryMedia items={media} label="Mídias da depilação a laser" /></div></section>
<section class="section"><div class="wrap"><div class="section-head"><p class="eyebrow">A sessão</p><h2>Você sabe o que acontece em cada etapa.</h2></div><div class="cards"><article class="card"><span class="number">01</span><h3>Avaliação</h3><p>Conversamos sobre pele, pelos, áreas de interesse e histórico de cuidados.</p></article><article class="card"><span class="number">02</span><h3>Preparação</h3><p>Você recebe orientações sobre o que fazer antes da sessão.</p></article><article class="card"><span class="number">03</span><h3>Aplicação</h3><p>A sessão é realizada de acordo com o protocolo e os parâmetros definidos.</p></article></div></div></section>
<section class="section sand"><div class="wrap split"><div><p class="eyebrow">Áreas comuns</p><h2>Atendimento para diferentes regiões do corpo.</h2></div><ul class="checklist"><li>Axilas e virilha</li><li>Rosto e buço</li><li>Pernas e braços</li><li>Costas, peito e abdômen</li></ul></div></section>
<section class="section treatment-faq"><div class="wrap faq-narrow"><div class="section-head centered"><p class="eyebrow">Dúvidas frequentes</p><h2>Perguntas sobre depilação a laser.</h2><p>Informações para você chegar à avaliação com mais clareza.</p></div><div class="faq">{laserFaqs.map(([question, answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
<section class="section"><div class="wrap" style="text-align:center"><h2>Quer entender se é indicado para você?</h2><p style="margin-inline:auto">A avaliação sem custo é o melhor ponto de partida para falar sobre pele, áreas e expectativas.</p><a class="btn" href={whatsapp('Olá! Gostaria de agendar uma avaliação para depilação a laser.')} target="_blank" rel="noopener">Agendar avaliação</a></div></section>
</SiteLayout>
